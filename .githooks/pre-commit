#!/usr/bin/env python3
import sys
import os
import subprocess
import re

def is_unlocked() -> bool:
    # 1. Environment variable
    if os.environ.get("UNLOCK") in ("1", "true", "TRUE", "yes", "YES"):
        return True

    # 2. Check parent git process arguments
    ppid = os.getppid()
    try:
        res = subprocess.run(["ps", "-o", "args=", "-p", str(ppid)], capture_output=True, text=True)
        cmdline = res.stdout.strip()
        if "UNLOCK" in cmdline:
            return True
        # Check -F or --file
        m = re.search(r'(?:-F|--file)[=\s]+([^\s]+)', cmdline)
        if m:
            file_path = m.group(1)
            if os.path.exists(file_path):
                with open(file_path, "r", errors="ignore") as f:
                    if "UNLOCK" in f.read():
                        return True
    except Exception:
        pass

    # 3. Check .git/COMMIT_EDITMSG if present
    try:
        git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True).stdout.strip()
        msg_file = os.path.join(git_dir, "COMMIT_EDITMSG")
        if os.path.exists(msg_file):
            with open(msg_file, "r", errors="ignore") as f:
                if "UNLOCK" in f.read():
                    return True
    except Exception:
        pass

    return False


def get_staged_files() -> list[str]:
    res = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True, text=True)
    return [line.strip() for line in res.stdout.splitlines() if line.strip()]


def extract_claim_and_definitions(content: str) -> list[str]:
    lines = content.splitlines()
    in_section = False
    section_lines = []
    for line in lines:
        if "CLAIM (FROZEN" in line:
            in_section = True
        elif "METRICS AND PAIRED METRICS" in line:
            in_section = False
        if in_section:
            section_lines.append(line.rstrip())
    return section_lines


def check_plan_section_changed() -> bool:
    try:
        head_proc = subprocess.run(["git", "show", "HEAD:PLAN.md"], capture_output=True, text=True)
        if head_proc.returncode != 0:
            return False
        staged_proc = subprocess.run(["git", "show", ":PLAN.md"], capture_output=True, text=True)
        if staged_proc.returncode != 0:
            return False
        
        head_sec = extract_claim_and_definitions(head_proc.stdout)
        staged_sec = extract_claim_and_definitions(staged_proc.stdout)
        return head_sec != staged_sec
    except Exception:
        return False


def main():
    staged = get_staged_files()
    if not staged:
        sys.exit(0)

    violations = []

    # Check direct protected files
    direct_protected = [
        "tests/test_static.py",
        "tests/verify_t1.py",
        "evals/split.json",
    ]

    for file_path in direct_protected:
        if file_path in staged:
            violations.append(file_path)

    # Check CLAIM and DEFINITIONS in PLAN.md
    if "PLAN.md" in staged:
        if check_plan_section_changed():
            violations.append("PLAN.md (CLAIM and DEFINITIONS section)")

    if violations:
        if is_unlocked():
            print("[PRE-COMMIT] Protected files modified, but UNLOCK detected. Allowing commit.")
            sys.exit(0)
        else:
            print("=" * 70, file=sys.stderr)
            print("[PRE-COMMIT BLOCKED] Commit contains protected files or sections:", file=sys.stderr)
            for v in violations:
                print(f"  - {v}", file=sys.stderr)
            print("\nProtection Rule: Edits to protected files require the word 'UNLOCK' in the commit message.", file=sys.stderr)
            print("Example:", file=sys.stderr)
            print("  git commit -m \"UNLOCK: update static tests\"", file=sys.stderr)
            print("=" * 70, file=sys.stderr)
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
